# ---------------------------------------------------------------------------
# Database (PostgreSQL 16 running natively on your machine)
# ---------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://whatsapp:CHANGE_ME@localhost:5432/whatsapp_scheduler?schema=public"

# ---------------------------------------------------------------------------
# Redis (started via docker compose — see docs/SETUP.md)
# ---------------------------------------------------------------------------
REDIS_URL="redis://127.0.0.1:6379"

# ---------------------------------------------------------------------------
# Meta WhatsApp Cloud API
# ---------------------------------------------------------------------------
# Permanent token from Meta Business Suite > System Users, or the temporary
# 24-hour token shown in the API Setup panel (fine for local testing).
WHATSAPP_ACCESS_TOKEN=""

# "From" phone number ID — API Setup panel, not the phone number itself.
WHATSAPP_PHONE_NUMBER_ID=""

# WhatsApp Business Account ID (used for template management).
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# You invent this string; type the same value into Meta's webhook config.
WHATSAPP_VERIFY_TOKEN=""

# App Secret from Meta App Dashboard > App settings > Basic.
# REQUIRED to validate webhook signatures (not optional in production).
WHATSAPP_APP_SECRET=""

# ---------------------------------------------------------------------------
# Message mode
# ---------------------------------------------------------------------------
# false -> free-form text. Only works inside a 24h customer service window
#          (i.e. when the recipient messaged you recently). Best for testing
#          with your own number.
# true  -> approved template. Required for business-initiated messages.
WHATSAPP_USE_TEMPLATE="false"
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANGUAGE="en_US"

WHATSAPP_API_VERSION="v21.0"
WHATSAPP_GRAPH_BASE_URL="https://graph.facebook.com"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_TIMEZONE="Asia/Kolkata"
LOG_LEVEL="info"
# WORKER_CONCURRENCY="2"
